pipeline {

    agent any

    parameters {
        string(
            name: 'BUILD_TAG_REF',
            defaultValue: 'latest',
            description: 'Docker image tag to build and deploy'
        )
    }

    environment {

        // Non-secret configuration
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '683613034915'

        ECR_REPO = 'swiftkart-ai-assistant'

        ECR_REGISTRY =
            "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        EC2_HOST = '${PUBLIC_IP}'

        APP_NAME = 'swiftkart-app'

        SECRET_NAME = 'swiftkart/prod/env'

        IMAGE_TAG = "${params.BUILD_TAG_REF}"
    }

    stages {

        /*
         * ============================================================
         * 1. CHECKOUT SOURCE CODE
         * ============================================================
         *
         * This job is configured as "Pipeline script",
         * NOT "Pipeline script from SCM".
         *
         * Therefore we explicitly checkout the GitHub repository.
         */
        stage('Checkout') {

            steps {

                git(
                    branch: 'main',
                    credentialsId: 'github-credentials',
                    url: 'https://github.com/java2786/swiftkart-ai-assistant-project-1'
                )
            }
        }


        /*
         * ============================================================
         * 2. BUILD DOCKER IMAGE
         * ============================================================
         */
        stage('Build Docker Image') {
            steps {
                sh '''
                    set -e

                    echo "Building Docker image for linux/amd64..."

                    docker build \
                        --platform linux/amd64 \
                        -t "${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}" \
                        .

                    echo "Docker image built successfully."
                '''
            }
        }

        stage('Verify Image Architecture') {
            steps {
                sh '''
                    set -e

                    echo "Checking image architecture..."

                    docker image inspect \
                        "${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}" \
                        --format='Architecture={{.Architecture}} OS={{.Os}}'
                '''
            }
        }
        /*
         * ============================================================
         * 3. PUSH IMAGE TO AMAZON ECR
         * ============================================================
         *
         * Jenkins uses its own AWS IAM credentials here.
         *
         * Jenkins credential:
         *     aws-jenkins
         */
        stage('Push Image to ECR') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-jenkins'
                    ]
                ]) {

                    sh '''
                        set -e

                        echo "=========================================="
                        echo "Logging into Amazon ECR"
                        echo "=========================================="

                        aws ecr get-login-password \
                            --region "${AWS_REGION}" \
                        | docker login \
                            --username AWS \
                            --password-stdin "${ECR_REGISTRY}"

                        echo ""
                        echo "ECR login successful."

                        echo ""
                        echo "Pushing Docker image..."

                        docker push \
                            "${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}"

                        echo ""
                        echo "=========================================="
                        echo "Image pushed successfully"
                        echo "=========================================="

                        echo "${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}"
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 4. DEPLOY TO EC2
         * ============================================================
         *
         * Jenkins only SSHs into EC2.
         *
         * IMPORTANT:
         * Jenkins does NOT receive the OpenAI/Tavily keys.
         *
         * EC2 obtains those values from AWS Secrets Manager using
         * its IAM role.
         *
         * Jenkins credential:
         *     ec2-ssh-key
         */
        stage('Deploy to EC2') {

            steps {

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'ec2-ssh-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "=========================================="
                        echo "Deploying to EC2"
                        echo "=========================================="

                        echo "EC2 host : ${EC2_HOST}"
                        echo "Image    : ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}"

                        ssh \
                            -o StrictHostKeyChecking=no \
                            -i "${SSH_KEY}" \
                            "${SSH_USER}@${EC2_HOST}" \
                            "AWS_REGION='${AWS_REGION}' \
                             ECR_REGISTRY='${ECR_REGISTRY}' \
                             ECR_REPO='${ECR_REPO}' \
                             IMAGE_TAG='${IMAGE_TAG}' \
                             SECRET_NAME='${SECRET_NAME}' \
                             APP_NAME='${APP_NAME}' \
                             bash -s" <<'REMOTE_SCRIPT'

set -e

echo "=========================================="
echo "EC2 deployment started"
echo "=========================================="


# ------------------------------------------------------------
# 1. Login to ECR
# ------------------------------------------------------------

echo ""
echo "Logging into Amazon ECR..."

aws ecr get-login-password \
    --region "${AWS_REGION}" \
| docker login \
    --username AWS \
    --password-stdin "${ECR_REGISTRY}"

echo "ECR login successful."


# ------------------------------------------------------------
# 2. Pull Docker image
# ------------------------------------------------------------

echo ""
echo "Pulling Docker image..."

docker pull \
    "${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}"

echo "Docker image pulled successfully."


# ------------------------------------------------------------
# 3. Read secrets from AWS Secrets Manager
# ------------------------------------------------------------

echo ""
echo "Reading application secrets from AWS Secrets Manager..."

SECRET_JSON=$(aws secretsmanager get-secret-value \
    --secret-id "${SECRET_NAME}" \
    --region "${AWS_REGION}" \
    --query SecretString \
    --output text)


# Extract OpenAI API key
OPENAI_KEY=$(echo "${SECRET_JSON}" | jq -r '.OPENAI_API_KEY // empty')

# Extract Tavily API key
TAVILY_KEY=$(echo "${SECRET_JSON}" | jq -r '.TAVILY_API_KEY // empty')


# ------------------------------------------------------------
# 4. Validate required secret
# ------------------------------------------------------------

if [ -z "${OPENAI_KEY}" ]; then

    echo "ERROR: OPENAI_API_KEY was not found in Secrets Manager."

    exit 1
fi


if [ -z "${TAVILY_KEY}" ]; then

    echo "WARNING: TAVILY_API_KEY was not found."

    echo "The application will run without Tavily web search."
fi


echo "Application secrets retrieved successfully."


# ------------------------------------------------------------
# 5. Stop existing container
# ------------------------------------------------------------

echo ""
echo "Stopping existing container..."

docker stop "${APP_NAME}" || true


# ------------------------------------------------------------
# 6. Remove existing container
# ------------------------------------------------------------

echo ""
echo "Removing existing container..."

docker rm "${APP_NAME}" || true


# ------------------------------------------------------------
# 7. Start new container
# ------------------------------------------------------------

echo ""
echo "Starting new container..."

docker run -d \
    --name "${APP_NAME}" \
    --restart unless-stopped \
    -p 8080:8080 \
    -e OPENAI_API_KEY="${OPENAI_KEY}" \
    -e TAVILY_API_KEY="${TAVILY_KEY}" \
    "${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}"


# ------------------------------------------------------------
# 8. Verify container
# ------------------------------------------------------------

echo ""
echo "Container started."

echo ""
echo "Running container status..."

docker ps \
    --filter "name=${APP_NAME}"


echo ""
echo "=========================================="
echo "EC2 deployment completed"
echo "=========================================="

REMOTE_SCRIPT
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 5. HEALTH CHECK
         * ============================================================
         */
        stage('Health Check') {

            steps {

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'ec2-ssh-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "=========================================="
                        echo "Running application health check on EC2"
                        echo "=========================================="

                        ssh \
                            -o StrictHostKeyChecking=no \
                            -i "${SSH_KEY}" \
                            "${SSH_USER}@${EC2_HOST}" \
                            "
                                set -e

                                echo 'Waiting for application to start...'
                                sleep 15

                                echo 'Checking application health...'

                                curl --fail \
                                    http://localhost:8080/actuator/health

                                echo ''
                                echo '=========================================='
                                echo 'Health check passed'
                                echo '=========================================='
                            "
                    '''
                }
            }
        }


    /*
     * ================================================================
     * POST BUILD
     * ================================================================
     */
    post {

        success {

            echo 'SwiftKart deployment completed successfully.'
        }

        failure {

            echo 'SwiftKart deployment failed.'
        }
    }
}